{
  "name": "samavada",
  "version": "1.0.0",
  "description": "\u0938\u0902\u0935\u093e\u0926\u0903 \u2014 conversational Sanskrit (samavada.si). Next.js + Payload CMS + Vidyut.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "grammar": "python3 api/grammar.py",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=6144\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "ci": "payload migrate && npm run build",
    "setup": "npm run migrate && npm run seed",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "seed": "tsx --env-file=.env scripts/seed.ts",
    "vidyut:data": "python3 -c \"import vidyut; vidyut.download_data('vidyut-data')\"",
    "vidyut:generate": "python3 scripts/vidyut/generate_all.py && python3 scripts/vidyut/generate_nouns.py",
    "vidyut:verify": "python3 scripts/vidyut/verify.py",
    "vidyut:verify:cms": "npm run export:forms && python3 scripts/vidyut/verify.py --cms data/export/cms-forms.json",
    "export:forms": "tsx --env-file=.env scripts/export-forms.ts",
    "ambuda:data": "bash scripts/ambuda/download.sh",
    "ambuda:meanings": "python3 scripts/ambuda/mw_glosses.py",
    "ambuda:examples": "python3 scripts/ambuda/find_examples.py",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/noto-serif-devanagari": "^5.3.0",
    "@fontsource/noto-serif-kannada": "^5.3.0",
    "@fontsource/noto-serif-tamil": "^5.3.0",
    "@fontsource/noto-serif-telugu": "^5.3.0",
    "@fontsource/rozha-one": "^5.3.0",
    "@payloadcms/db-postgres": "3.93.0",
    "@payloadcms/next": "3.93.0",
    "@payloadcms/richtext-lexical": "3.93.0",
    "@payloadcms/ui": "3.93.0",
    "@tailwindcss/postcss": "^4.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "lucide-react": "^1.73.0",
    "next": "16.4.1",
    "payload": "3.93.0",
    "postcss": "^8.5.33",
    "radix-ui": "^1.8.1",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "server-only": "^0.0.1",
    "sharp": "0.35.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.4.1",
    "jsdom": "28.0.0",
    "prettier": "^3.4.2",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": "^22.23.5 || ^24.22.3 || >=26.13.1",
    "pnpm": "^9 || ^10 || ^11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}