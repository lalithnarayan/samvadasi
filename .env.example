# Postgres — local (docker compose up -d db) or a free Neon database (https://neon.tech)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/samvada
# Any long random string (openssl rand -hex 32)
PAYLOAD_SECRET=
# Public URL of the site
NEXT_PUBLIC_SERVER_URL=https://samavada.si
# First admin account created by `npm run seed`
SEED_ADMIN_EMAIL=admin@samavada.si
SEED_ADMIN_PASSWORD=
# Local Vidyut grammar service port (python api/grammar.py)
VIDYUT_PORT=5328
# Local only: where the Vidyut grammar service runs. Leave unset on Vercel.
VIDYUT_URL=http://127.0.0.1:5328
