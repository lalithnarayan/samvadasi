  "text": "विवेकः",
  "kind": "name",
  "gender": "m",
  "meaning_en": "discernment, wisdom",
  "meaning_te": "వివేకం",
  "meaning_kn": "ವಿವೇಕ",
  "meaning_ta": "விவேகம்",
  "when_en": "Knowing right from wrong.",
  "when_te": "మంచి చెడు తెలుసుకోవడం.",
  "when_kn": "ಒಳಿತು ಕೆಡುಕು ತಿಳಿಯುವುದು.",
  "when_ta": "நல்லது கெட்டது அறிதல்.",
  "order": 26
 },
 {
  "text": "सिद्धार्थः",
  "kind": "name",
  "gender": "m",
  "meaning_en": "one who has reached his goal",
  "meaning_te": "లక్ష్యం సాధించినవాడు",
  "meaning_kn": "ಗುರಿ ಮುಟ್ಟಿದವನು",
  "meaning_ta": "இலக்கை அடைந்தவன்",
  "when_en": "The Buddha's given name.",
  "when_te": "బుద్ధుని అసలు పేరు.",
  "when_kn": "ಬುದ್ಧನ ಮೂಲ ಹೆಸರು.",
  "when_ta": "புத்தரின் இயற்பெயர்.",
  "order": 27
 },
 {
  "text": "प्रणवः",
  "kind": "name",
  "gender": "m",
  "meaning_en": "the sacred syllable ॐ",
  "meaning_te": "ఓంకారం",
  "meaning_kn": "ಓಂಕಾರ",
  "meaning_ta": "ஓம்காரம்",
  "when_en": "The sound ॐ.",
  "when_te": "ఓం అనే నాదం.",
  "when_kn": "ಓಂ ಎಂಬ ನಾದ.",
  "when_ta": "ஓம் என்ற ஒலி.",
  "order": 28
 },
 {
  "text": "अनिरुद्धः",
  "kind": "name",
  "gender": "m",
  "meaning_en": "unstoppable",
  "meaning_te": "ఆపలేనివాడు",
  "meaning_kn": "ತಡೆಯಲಾಗದವನು",
  "meaning_ta": "தடுக்க முடியாதவன்",
  "when_en": "Grandson of Kṛṣṇa.",
  "when_te": "శ్రీకృష్ణుని మనవడు.",
  "when_kn": "ಶ್ರೀಕೃಷ್ಣನ ಮೊಮ್ಮಗ.",
  "when_ta": "கிருஷ்ணனின் பேரன்.",
  "order": 29
 },
 {
  "text": "राघवः",
  "kind": "name",
  "gender": "m",
  "meaning_en": "of the Raghu family",
  "meaning_te": "రఘువంశంవాడు",
  "meaning_kn": "ರಘುವಂಶದವನು",
  "meaning_ta": "ரகு குலத்தவன்",
  "when_en": "A name of Rāma.",
  "when_te": "శ్రీరాముని పేరు.",
  "when_kn": "ಶ್ರೀರಾಮನ ಹೆಸರು.",
  "when_ta": "ராமனின் பெயர்.",
  "order": 30
 },
 {
  "text": "हर्षः",
  "kind": "name",
  "gender": "m",
  "meaning_en": "joy, delight",
  "meaning_te": "సంతోషం",
  "meaning_kn": "ಹರ್ಷ",
  "meaning_ta": "மகிழ்ச்சி",
  "when_en": "Happiness.",
  "when_te": "సంతోషం.",
  "when_kn": "ಸಂತೋಷ.",
  "when_ta": "மகிழ்ச்சி.",
  "order": 31
 },
 {
  "text": "अदितिः",
  "kind": "name",
  "gender": "f",
  "meaning_en": "boundless",
  "meaning_te": "అనంతమైనది",
  "meaning_kn": "ಅಪರಿಮಿತ",
  "meaning_ta": "எல்லையற்றவள்",
  "when_en": "Mother of the gods.",
  "when_te": "దేవతల తల్లి.",
  "when_kn": "ದೇವತೆಗಳ ತಾಯಿ.",
  "when_ta": "தேவர்களின் தாய்.",
  "order": 32
 },
 {
  "text": "अनन्या",
  "kind": "name",
  "gender": "f",
  "meaning_en": "unique, one of a kind",
  "meaning_te": "సాటిలేనిది",
  "meaning_kn": "ಅನನ್ಯ",
  "meaning_ta": "ஒப்பற்றவள்",
  "when_en": "\"No other like her\".",
  "when_te": "\"ఆమెలాంటి వారు ఇంకొకరు లేరు\".",
  "when_kn": "\"ಅವಳಂಥವರು ಇನ್ನೊಬ್ಬರಿಲ್ಲ\".",
  "when_ta": "\"அவளைப் போல வேறொருவர் இல்லை\".",
  "order": 33
 },
 {
  "text": "दिव्या",
  "kind": "name",
  "gender": "f",
  "meaning_en": "divine, radiant",
  "meaning_te": "దివ్యమైన",
  "meaning_kn": "ದಿವ್ಯ",
  "meaning_ta": "தெய்வீகமான",
  "when_en": "Shining like the heavens.",
  "when_te": "దివిలా ప్రకాశించే.",
  "when_kn": "ದಿವಿಯಂತೆ ಹೊಳೆಯುವ.",
  "when_ta": "வானம் போல் ஒளிரும்.",
  "order": 34
 },
 {
  "text": "मेधा",
  "kind": "name",
  "gender": "f",
  "meaning_en": "intelligence",
  "meaning_te": "మేధ, తెలివి",
  "meaning_kn": "ಮೇಧಾ, ಬುದ್ಧಿ",
  "meaning_ta": "அறிவு",
  "when_en": "Sharp understanding.",
  "when_te": "చురుకైన బుద్ధి.",
  "when_kn": "ಚುರುಕಾದ ಬುದ್ಧಿ.",
  "when_ta": "கூர்மையான அறிவு.",
  "order": 35
 },
 {
  "text": "श्रुतिः",
  "kind": "name",
  "gender": "f",
  "meaning_en": "what is heard; the Veda",
  "meaning_te": "వినబడేది; వేదం",
  "meaning_kn": "ಕೇಳಿದ್ದು; ವೇದ",
  "meaning_ta": "கேட்கப்படுவது; வேதம்",
  "when_en": "Also a musical note.",
  "when_te": "సంగీతంలో శ్రుతి కూడా.",
  "when_kn": "ಸಂಗೀತದ ಶ್ರುತಿಯೂ.",
  "when_ta": "இசையில் சுருதியும்.",
  "order": 36
 },
 {
  "text": "प्रिया",
  "kind": "name",
  "gender": "f",
  "meaning_en": "dear, beloved",
  "meaning_te": "ప్రియమైన",
  "meaning_kn": "ಪ್ರಿಯ",
  "meaning_ta": "அன்பானவள்",
  "when_en": "One who is loved.",
  "when_te": "అందరికీ ఇష్టమైనది.",
  "when_kn": "ಎಲ್ಲರಿಗೂ ಇಷ್ಟವಾದವಳು.",
  "when_ta": "எல்லோருக்கும் பிரியமானவள்.",
  "order": 37
 },
 {
  "text": "लक्ष्मीः",
  "kind": "name",
  "gender": "f",
  "meaning_en": "fortune; the goddess Lakṣmī",
  "meaning_te": "సంపద; లక్ష్మీదేవి",
  "meaning_kn": "ಸಂಪತ್ತು; ಲಕ್ಷ್ಮೀದೇವಿ",
  "meaning_ta": "செல்வம்; லட்சுமி தேவி",
  "when_en": "Goddess of wealth.",
  "when_te": "సంపదకు దేవత.",
  "when_kn": "ಸಂಪತ್ತಿನ ದೇವತೆ.",
  "when_ta": "செல்வத்தின் தெய்வம்.",
  "order": 38
 },
 {
  "text": "सरस्वती",
  "kind": "name",
  "gender": "f",
  "meaning_en": "the goddess of learning",
  "meaning_te": "చదువుల తల్లి",
  "meaning_kn": "ವಿದ್ಯಾದೇವತೆ",
  "meaning_ta": "கல்வியின் தெய்வம்",
  "when_en": "Also an ancient river.",
  "when_te": "ఒక ప్రాచీన నది కూడా.",
  "when_kn": "ಒಂದು ಪ್ರಾಚೀನ ನದಿಯೂ.",
  "when_ta": "ஒரு பழைய நதியும்.",
  "order": 39
 },
 {
  "text": "कीर्तिः",
  "kind": "name",
  "gender": "f",
  "meaning_en": "fame, glory",
  "meaning_te": "కీర్తి",
  "meaning_kn": "ಕೀರ್ತಿ",
  "meaning_ta": "புகழ்",
  "when_en": "Good name.",
  "when_te": "మంచి పేరు.",
  "when_kn": "ಒಳ್ಳೆಯ ಹೆಸರು.",
  "when_ta": "நற்பெயர்.",
  "order": 40
 },
 {
  "text": "गायत्री",
  "kind": "name",
  "gender": "f",
  "meaning_en": "the Gāyatrī metre and mantra",
  "meaning_te": "గాయత్రీ ఛందస్సు, మంత్రం",
  "meaning_kn": "ಗಾಯತ್ರೀ ಛಂದಸ್ಸು, ಮಂತ್ರ",
  "meaning_ta": "காயத்ரி சந்தம், மந்திரம்",
  "when_en": "\"She who protects the singer\".",
  "when_te": "\"పాడేవారిని కాపాడేది\".",
  "when_kn": "\"ಹಾಡುವವರನ್ನು ಕಾಪಾಡುವವಳು\".",
  "when_ta": "\"பாடுபவரைக் காப்பவள்\".",
  "order": 41
 },
 {
  "text": "नन्दिनी",
  "kind": "name",
  "gender": "f",
  "meaning_en": "one who delights",
  "meaning_te": "ఆనందపరిచేది",
  "meaning_kn": "ಆನಂದ ನೀಡುವವಳು",
  "meaning_ta": "மகிழ்விப்பவள்",
  "when_en": "Also Vasiṣṭha's wish-granting cow.",
  "when_te": "వసిష్ఠుని కామధేనువు పేరు కూడా.",
  "when_kn": "ವಸಿಷ್ಠರ ಕಾಮಧೇನುವಿನ ಹೆಸರೂ.",
  "when_ta": "வசிஷ்டரின் காமதேனுவின் பெயரும்.",
  "order": 42
 }
]